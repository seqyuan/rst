{
  "name": "@seqyuan/vite-plugin-rst",
  "version": "0.1.4",
  "description": "Vite plugin for importing .rst files as HTML or React components",
  "type": "module",
  "license": "MIT",
  "author": "seqyuan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seqyuan/rst.git",
    "directory": "packages/vite-plugin"
  },
  "homepage": "https://github.com/seqyuan/rst#readme",
  "bugs": {
    "url": "https://github.com/seqyuan/rst/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "dependencies": {
    "@seqyuan/rst-renderer": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
