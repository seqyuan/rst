{
  "name": "@seqyuan/vite-plugin-rst",
  "version": "0.1.0",
  "description": "Vite plugin for importing .rst files as HTML or React components",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "dependencies": {
    "@seqyuan/rst-renderer": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
